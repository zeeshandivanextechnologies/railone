# Server Configuration
PORT=5000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=railone_db

# Gmail SMTP Credentials
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Razorpay Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# RailCore Tech API
RAILCORE_API_KEY=your_railcore_api_key
RAILCORE_BASE_URL=https://ir.railcore.tech/v1

# RailRadar Real-time Live Tracking API (Backup)
RAILRADAR_API_KEY=your_railradar_api_key
RAILRADAR_BASE_URL=https://api.railradar.in/v1
